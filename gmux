# gmux menu in a temporary side pane. Native tmux menus do not fit: in 3.1 any
# mouse motion counts as a button release (closing it or picking an item by
# accident), and before 3.5 they have no mouse support when opened by keyboard.

MENU_WIDTH = 40
MOUSE_ALL = "\033[?1003h"  # terminal also reports motion (hover)


def picker_rows():
    """Menu rows: ("item", label, key, cmd) / ("title", text)."""
    sections = menu_items()
    rows = [("item", *it) for it in sections[""]]
    for name in SECTIONS:
        rows += [("title", name)] + [("item", *it) for it in sections[name]]
    return rows


class Picker:
    def __init__(self, scr, rows):
        self.scr = scr
        self.sel = self.top = 0
        self.set_rows(rows)
        curses.curs_set(0)
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)  # hovered item
        curses.init_pair(2, curses.COLOR_YELLOW, -1)                # section titles
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        curses.mouseinterval(0)  # separate press and release, no delay
        print(MOUSE_ALL, end="", flush=True)
        scr.keypad(True)

    def set_rows(self, rows):
        self.rows = rows
        self.items = [i for i, r in enumerate(rows) if r[0] == "item"]
        self.sel = min(self.sel, len(self.items) - 1)

    def draw(self):
        s = self.scr
        s.erase()
        h, w = s.getmaxyx()
        view = max(1, h - 2)
        cur = self.items[self.sel]
        if cur < self.top:
            self.top = cur - (1 if cur and self.rows[cur - 1][0] == "title" else 0)
        elif cur >= self.top + view:
            self.top = cur - view + 1
        s.addnstr(0, 0, f" gmux v{VERSION} ".center(w), w - 1, curses.A_REVERSE | curses.A_BOLD)
        for y, r in enumerate(self.rows[self.top:self.top + view], start=1):
            if r[0] == "title":  # title: separator line, not clickable
                s.addnstr(y, 0, f"── {r[1].upper()} ".ljust(w, "─"), w - 1,
                          curses.color_pair(2) | curses.A_DIM)
            else:
                text = f"   {r[1]}".ljust(w - 6) + f"({r[2]})".rjust(5)
                attr = curses.color_pair(1) if self.top + y - 1 == cur else 0
                s.addnstr(y, 0, text.ljust(w - 1), w - 1, attr)
        s.addnstr(h - 1, 1, "click/Enter: run  Esc: close", w - 2, curses.A_DIM)
        s.refresh()

    def item_at(self, y):
        idx = self.top + y - 1
        return self.items.index(idx) if 0 < y < self.scr.getmaxyx()[0] - 1 and idx in self.items else None

    def loop(self, choose, tick, accept_keys=lambda: True):
        """Run until closed. choose(row) runs an item and returns True to keep
        the menu open. tick() runs every second and returns fresh rows, or None
        to close. accept_keys() tells whether keyboard input is for the menu."""
        keys = {self.rows[i][2]: i for i in self.items}
        self.scr.timeout(1000)
        while True:
            self.draw()
            try:
                ch = self.scr.get_wch()
            except curses.error:  # timeout
                rows = tick()
                if rows is None:
                    return
                self.set_rows(rows)
                continue
            pick = None
            if ch == curses.KEY_MOUSE:
                try:
                    _, _, y, _, b = curses.getmouse()
                except curses.error:
                    continue
                if b & WHEEL_UP:
                    ch = curses.KEY_UP
                elif b & WHEEL_DOWN:
                    ch = curses.KEY_DOWN
                else:
                    pos = self.item_at(y)
                    if pos is not None:
                        self.sel = pos  # hover or click: highlight
                        if b & (curses.BUTTON1_RELEASED | curses.BUTTON1_CLICKED):
                            pick = pos
                    if pick is None:
                        continue
            elif not accept_keys():  # e.g. keys copied here by synchronize-panes
                continue
            if pick is None:
                if ch in ("\x1b", "q"):
                    return
                if ch in (curses.KEY_UP, curses.KEY_DOWN):
                    self.sel = (self.sel + (1 if ch == curses.KEY_DOWN else -1)) % len(self.items)
                    continue
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    pick = self.sel
                elif ch in keys:
                    pick = self.items.index(keys[ch])
                else:
                    continue
            self.sel = pick
            if not choose(self.rows[self.items[pick]]):
                return
            rows = tick()
            if rows is None:
                return
            self.set_rows(rows)


def expand(texts, pane):
    """Expand tmux formats (#W, #S, on/off states) of `texts` for `pane`.
    Return None if tmux fails."""
    joined = " @@ ".join(t.replace("%", "%%") for t in texts)  # display-message: %% -> %
    ok, out = tmux("display-message", "-p", "-t", pane, joined)
    return out.rstrip("\n").split(" @@ ") if ok else None


def expanded_rows(orig):
    """Menu rows with labels and commands expanded for pane `orig`, before the
    menu pane changes the window name."""
    rows = picker_rows()
    values = expand([t for r in rows if r[0] == "item" for t in (r[1], r[3])], orig)
    if values is None:
        return rows
    values = iter(values)
    return [("item", next(values), r[2], next(values)) if r[0] == "item" else r for r in rows]


def item_command(key, pane, fallback):
    """Command of menu item `key` expanded for `pane` right now: the rows shown
    may be up to a few seconds old (another window was selected meanwhile)."""
    raw = next((r[3] for r in picker_rows() if r[0] == "item" and r[2] == key), None)
    values = expand([raw], pane) if raw else None
    return values[0] if values else fallback


CLOSE_KEYS = ("s", "z", "N", "S", "d")  # Sessions, Zoom, New/Switch session, Detach
INTERACTIVE = ("command-prompt", "confirm-before", "choose-tree")  # wait for the user


class MenuPane:
    """The menu pane stays open: each item runs on the work pane (the active
    one, or the last active one when the menu has focus), then the menu takes
    the focus back and follows window changes."""

    def __init__(self, orig):
        self.me = os.environ.get("TMUX_PANE", "")
        self.orig = orig
        self.env = {k: v for k, v in os.environ.items() if k != "TMUX_PANE"}

    def get(self, fmt, target=None):
        ok, out = tmux("display-message", "-p", "-t", target or self.me, fmt)
        return out.strip() if ok else ""

    def window(self):
        return self.get("#{window_id}")

    def active(self):
        return self.get("#{pane_active}") == "1"

    def synced(self):
        """synchronize-panes copies keys typed anywhere to the menu too: the
        menu is then mouse only and leaves the focus on the work pane."""
        return self.get("#{?synchronize-panes,1,0}") == "1"

    def accept_keys(self):
        return self.active() and not self.synced()

    def target(self):
        """Work pane for the next action, None if only the menu is left."""
        win = self.window()
        pane = self.get("#{pane_id}", f"{win}.{{last}}") if self.active() else self.get("#{pane_id}", win)
        if pane and pane != self.me:
            return pane
        ok, out = tmux("list-panes", "-t", win, "-F", "#{pane_id}")
        others = [p for p in out.split() if p != self.me] if ok else []
        return others[0] if others else None

    def follow(self):
        """Move the menu into the window the session now shows."""
        current = self.get("#{window_id}", self.get("#{session_id}") + ":")
        if current and current != self.window():
            tmux("join-pane", "-d", "-h", "-b", "-f", "-l", str(MENU_WIDTH), "-s", self.me, "-t", current)

    def script(self, cmd, target):
        return f"select-window -t {target}\nselect-pane -t {target}\n{cmd}\n"

    def run(self, cmd, target):
        subprocess.run(["tmux", "source-file", "-"], input=self.script(cmd, target), text=True,
                       env=self.env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def run_after_close(self, cmd, target):
        """Run once the menu pane is gone, so closing it cannot undo the action
        (a zoomed window unzooms when one of its panes closes)."""
        subprocess.Popen(["sh", "-c", 'sleep 0.2; printf "%s" "$1" | tmux source-file -', "sh",
                          self.script(cmd, target)], env=self.env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def choose(self, row):
        _, _, key, cmd = row
        self.follow()  # the user may have changed window since the last tick
        target = self.target()
        if target is None:
            return False
        cmd = item_command(key, target, cmd)
        if key in CLOSE_KEYS:
            self.run_after_close(cmd, target)
            return False
        self.run(cmd, target)
        self.follow()
        if not cmd.startswith(INTERACTIVE) and not self.synced():
            tmux("select-pane", "-t", self.me)  # prompts keep the focus on the work pane
        return True

    def tick(self):
        self.follow()  # first: target() looks for the work pane in the menu's window
        target = self.target()
        if target is None:
            return None
        return expanded_rows(target)


def run_pick(orig, rows_path):
    """Runs inside the menu pane."""
    os.environ.setdefault("ESCDELAY", "25")
    with open(rows_path) as f:
        rows = [tuple(r) for r in json.load(f)]
    os.remove(rows_path)
    menu = MenuPane(orig)
    if menu.target() is None:  # narrow terminal: menu alone in its window
        return run_pick_once(menu, rows)
    try:
        curses.wrapper(lambda scr: Picker(scr, rows).loop(menu.choose, menu.tick, menu.accept_keys))
    finally:
        print("\033[?1003l", end="", flush=True)


def run_pick_once(menu, rows):
    """Menu in its own window: choose one item, close, then run it on `orig`."""
    chosen = []

    def choose(row):
        chosen.append(row)
        return False
    try:
        curses.wrapper(lambda scr: Picker(scr, rows).loop(choose, lambda: rows))
    finally:
        print("\033[?1003l", end="", flush=True)
    if chosen:
        menu.run_after_close(chosen[0][3], menu.orig)


def run_menu(orig=None):
    """Open the menu left of pane `orig` (or in a window if too narrow).
    If a menu is open here: close it when it has the focus, else focus it."""
    orig = orig or os.environ.get("TMUX_PANE", "")
    ok, panes = tmux("list-panes", "-a", "-F",
                     "#{pane_id} #{window_id} #{pane_active} #{pane_start_command}")
    marker = f'"{SELF}" pick '  # menu pane command (tmux >= 3.2 escapes ")
    here = tmux("display-message", "-p", "-t", orig, "#{window_id}")[1].strip()
    for line in (panes.splitlines() if ok else []):
        pane, win, active = line.split()[:3]
        if marker not in line.replace('\\"', '"'):
            continue
        if win != here:
            tmux("kill-pane", "-t", pane)  # menu left in another window
        else:
            tmux("kill-pane" if active == "1" else "select-pane", "-t", pane)
            return
    fd, rows_path = tempfile.mkstemp(prefix="gmux-", suffix=".json")
    with os.fdopen(fd, "w") as f:
        json.dump(expanded_rows(orig), f)
    pick = f'"{SELF}" pick "{orig}" "{rows_path}"'
    ok, width = tmux("display-message", "-p", "-t", orig, "#{window_width}")
    if ok and width.strip().isdigit() and int(width) >= MENU_WIDTH + 20:
        ok, err = tmux("split-window", "-h", "-b", "-f", "-l", str(MENU_WIDTH), "-t", orig, pick)
    else:
        win = tmux("display-message", "-p", "-t", orig, "#{window_id}")[1].strip()
        ok, err = tmux("new-window", "-a", "-n", "gmux", "-t", win, pick)  # -a: next free index
    if not ok:
        os.remove(rows_path)
        notify(f"gmux: {err}")
        print(f"gmux: {err}", file=sys.stderr)


# ---------------------------------------------------------------- clipboard
# Mouse selection is copied by tmux to its buffer and, through OSC 52, to the
# clipboard of the computer running the terminal (Windows Terminal, iTerm2,
# kitty, WezTerm, xterm...). `gmux clip` also fills the X/Wayland clipboard when
# one is reachable: a local desktop, or X11 forwarding (MobaXterm, ssh -X) whose
# clipboard is synced with the PC. Then it confirms the copy.

OSC52_TERMS = ("xterm*", "screen*", "tmux*", "*kitty*", "alacritty*", "foot*",
               "wezterm*", "rxvt*", "st-*", "putty*")  # not "linux": its console prints OSC


def clip_sh():
    """Helper run on every copy. Plain sh: it starts in a few ms, where Python
    takes far longer (several hundred ms on a Raspberry Pi)."""
    return f"""#!/bin/sh
# Generated by gmux v{VERSION}: copies stdin to the desktop clipboard when one is
# reachable (local desktop, or X11 forwarding such as MobaXterm), then confirms.
text=$(cat; printf x); text=${{text%x}}  # keep trailing newlines
copied=
if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null; then
    printf %s "$text" | wl-copy && copied=1
elif [ -n "$DISPLAY" ] && command -v xclip >/dev/null; then
    printf %s "$text" | timeout 2 xclip -selection clipboard >/dev/null 2>&1 && copied=1
elif [ -n "$DISPLAY" ] && command -v xsel >/dev/null; then
    printf %s "$text" | timeout 2 xsel --clipboard --input && copied=1
elif command -v pbcopy >/dev/null; then
    printf %s "$text" | pbcopy && copied=1
fi
n=$(printf %s "$text" | wc -m | tr -d ' ')
msg="Copied $n character"; [ "$n" = 1 ] || msg="${{msg}}s"
[ -z "$copied" ] && [ -n "$DISPLAY" ] && msg="$msg. For your PC clipboard: apt install xclip"
# 4 s message; tmux < 3.2 has no -d, so raise display-time just for it
tmux display-message -d 4000 "$msg" 2>/dev/null || {{
    old=$(tmux show-options -gv display-time)
    tmux set-option -g display-time 4000
    tmux display-message "$msg"
    tmux set-option -g display-time "${{old:-750}}"
}}
"""


def clipboard_conf():
    """Mouse copy and paste: drag, double click (word) or triple click (line)
    copies; middle or right click pastes."""
    clip = f"sh '{CLIP_SH}'"
    copy = f'copy-pipe-and-cancel "{clip}"'
    # Copy a moment later when tmux has just redrawn (entering copy mode, option
    # change): it skips the clipboard (OSC 52) during a redraw.
    later_sh = f'sleep 0.03; tmux send-keys -X -t #{{pane_id}} copy-pipe-and-cancel \\"{clip}\\"'
    later = f'run-shell -b "{later_sh}"'
    # With mode-keys emacs (the default) tmux drops the last selected character;
    # vi keeps it, so mouse selections are copied as vi does, then restored.
    drag_copy = (f"if -F '#{{==:#{{mode-keys}},emacs}}' "
                 f'{{ set -w mode-keys vi ; run-shell -b "{later_sh} ; '
                 f'tmux set-option -wu -t #{{pane_id}} mode-keys" }} '
                 f"{{ send -X {copy} }}")
    paste_or_app = ("if -Ft= '#{||:#{mouse_any_flag},#{pane_in_mode}}' "
                    "{ select-pane -t= ; send -M } { select-pane -t= ; paste-buffer -p }")

    def select(action):  # from normal mode: enter copy mode, select, copy
        return (f"if -Ft= '#{{mouse_any_flag}}' {{ select-pane -t= ; send -M }} "
                f"{{ select-pane -t= ; copy-mode -t= ; send -X -t= {action} ; {later} }}")

    lines = ["set -s set-clipboard on"]
    lines += [f"set -s terminal-overrides[{90 + i}] '{t}:Ms=\\E]52;%p1%s;%p2%s\\007'"
              for i, t in enumerate(OSC52_TERMS)]
    for table in ("copy-mode", "copy-mode-vi"):
        lines += [f"bind -T {table} MouseDragEnd1Pane {drag_copy}",
                  f"bind -T {table} DoubleClick1Pane {{ select-pane ; send -X select-word ; {later} }}",
                  f"bind -T {table} TripleClick1Pane {{ select-pane ; send -X select-line ; {later} }}"]
    lines += [f"bind -n DoubleClick1Pane {select('select-word')}",
              f"bind -n TripleClick1Pane {select('select-line')}",
              f"bind -n MouseDown2Pane {paste_or_app}",
              f"bind -n MouseDown3Pane {paste_or_app}"]  # replaces the native pane menu
    return lines


# ---------------------------------------------------------------- install

BEGIN, END = "# >>> gmux >>>", "# <<< gmux <<<"


MENU_BIND = f"run-shell -b '\"{SELF}\" menu \"#{{pane_id}}\"'"


def tmux_version():
    """tmux version as a float (3.2a -> 3.2), 0 if unknown."""
    ok, out = tmux("-V")
    digits = "".join(c for c in out.split()[-1] if c.isdigit() or c == ".") if ok and out else ""
    try:
        return float(digits)
    except ValueError:
        return 0.0


# tmux formats shared by the status bar and the pane bars
IS_MENU = "#{m:* pick *,#{pane_start_command}}"  # the gmux menu pane runs `gmux pick`
PANE_LABEL = f"#{{?{IS_MENU},gmux menu,#P: #{{pane_current_command}}  #{{b:pane_current_path}}}}"
IS_SPLIT = f"#{{m:xx*,#{{P:#{{?{IS_MENU},,x}}}}}}"  # one x per real pane: 2+ = split


def windows_conf():
    """Make windows easy to tell apart: the current one is highlighted in the
    status bar, and switching windows shows its number and name for a moment
    (only when the session has more than one window)."""
    duration = "-d 2000 " if tmux_version() >= 3.2 else ""  # -d needs tmux 3.2
    return [
        "set -g window-status-separator ''",
        "set -g window-status-format ' #I:#W#{?window_zoomed_flag, [Z],} '",
        f"set -g window-status-current-format ' #I:#W#{{?window_zoomed_flag, [Z],}}"
        f"#{{?{IS_SPLIT}, > {PANE_LABEL},}} '",  # active pane when split
        "set -g window-status-current-style 'fg=black,bg=yellow,bold'",
        # index 90: keeps any session-window-changed hook the user set at index 0
        "set-hook -g session-window-changed[90] "
        "{ if -F '#{!=:#{session_windows},1}' "
        f"{{ display-message {duration}'Window #I: #W  (#{{session_windows}} windows)' }} }}",
    ]


def panes_conf():
    """When a window is split, draw a bar under each pane (number, running
    command, folder) and highlight the active one. The bars are switched on
    per window only while it holds at least two panes, the gmux menu aside,
    so an unsplit window keeps its full height."""
    style = "#{?pane_active,#[fg=black#,bg=yellow#,bold] > ,#[fg=default#,bg=default]   }"
    return [
        f"set -g pane-border-format '{style}{PANE_LABEL} #[default]'",
        "set -g pane-active-border-style 'fg=yellow'",
        f"set-hook -g window-layout-changed[90] {{ if -F '{IS_SPLIT}' "
        "{ set -w pane-border-status bottom } { set -w pane-border-status off } }",
    ]


def gmux_conf():
    """Generated tmux config: mouse, window and pane indicators, menu access."""
    return "\n".join([
        f"# Generated by gmux v{VERSION}. Do not edit: regenerated automatically by gmux.",
        "set -g mouse on",
        # clean up the status bar set by gmux < 1.6 (monitoring removed)
        "if-shell -F '#{m:*gmux*status*,#{status-left}}' "
        "'set -gu status-left ; set -gu status-left-length ; set -gu status-interval'",
        # MobaXterm / PuTTY (TERM=xterm) turn the mouse wheel into arrow keys on the
        # alternate screen: keep tmux off it for them so the wheel scrolls tmux
        "set -s terminal-overrides[89] 'xterm:smcup@:rmcup@'",
        *clipboard_conf(),
        *windows_conf(),
        *panes_conf(),
        f"bind m {MENU_BIND}",
        # left click on the session name, right click anywhere on the status bar
        *(f"bind -n {ev} {MENU_BIND}"
          for ev in ("MouseUp1StatusLeft", "MouseUp3StatusLeft", "MouseUp3Status",
                     "MouseUp3StatusRight")),
        # remove native menus opened on press, including those of older versions
        *(f"unbind -n {ev}" for ev in ("MouseDown1StatusLeft", "MouseDown3StatusLeft",
                                        "MouseDown3Status", "MouseDown3StatusRight")),
        ""])


def conf_block():
    return "\n".join([BEGIN, f"source-file \"{GMUX_CONF}\"", END, ""])


def strip_block(text):
    if BEGIN in text and END in text:
        start, end = text.index(BEGIN), text.index(END) + len(END)
        text = text[:start].rstrip("\n") + text[end:].lstrip("\n")
        text = text + "\n" if text and not text.endswith("\n") else text
    return text


def run_install(remove=False, quiet=False):
    text = strip_block(open(CONF).read() if os.path.exists(CONF) else "")
    if remove:
        for path in (GMUX_CONF, CLIP_SH):
            if os.path.exists(path):
                os.remove(path)
    else:
        os.makedirs(os.path.dirname(GMUX_CONF), exist_ok=True)
        for path, content in ((GMUX_CONF, gmux_conf()), (CLIP_SH, clip_sh())):
            with open(path, "w") as f:
                f.write(content)
        text = (text + "\n" if text else "") + conf_block()
    with open(CONF, "w") as f:
        f.write(text)
    if remove:
        print("gmux config removed. Restart tmux to undo the active settings.")
        return
    reloaded, _ = tmux("source-file", CONF)
    if quiet:
        return
    print(f"gmux config installed ({GMUX_CONF})" + (" and reloaded." if reloaded else "."))
    print("Menu: click the session name, right click the status bar, or prefix + m.")


def ensure_installed():
    """Set up the per-user config on first run, and refresh it when gmux was
    updated or moved (the generated config then differs)."""
    def read(path):
        return open(path).read() if os.path.exists(path) else ""
    if (conf_block() in read(CONF) and read(GMUX_CONF) == gmux_conf()
            and read(CLIP_SH) == clip_sh()):
        return
    run_install(quiet=True)
    if INSIDE:
        notify(f"gmux v{VERSION}: tmux config set up for this user")


def run_open(name):
    """Attach to session NAME, creating it first if it does not exist."""
    if not tmux("has-session", "-t", f"={name}")[0]:
        ok, err = tmux("new-session", "-d", "-s", name)
        if not ok:
            sys.exit(f"gmux: {err}")
    if INSIDE:
        tmux("switch-client", "-t", f"={name}")
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={name}"])


# ---------------------------------------------------------------- main

def main():
    if not shutil.which("tmux"):
        sys.exit("gmux: tmux is not installed.")
    args = sys.argv[1:]
    cmd = args[0] if args else ("menu" if INSIDE else "tui")
    if cmd not in ("pick", "clip", "copy-later", "install", "uninstall") and not cmd.startswith("-"):
        ensure_installed()  # first run for this user, or gmux was updated
    if cmd == "tui":
        run_tui()
    elif cmd == "menu":
        run_menu(*args[1:2])
    elif cmd == "pick" and len(args) > 2:
        run_pick(args[1], args[2])
    elif cmd in ("clip", "copy-later"):  # called by bindings of gmux < 1.11
        ensure_installed()  # regenerates the helper and reloads the new bindings
        if cmd == "clip":
            os.execvp("sh", ["sh", CLIP_SH])
        tmux("send-keys", "-X", "-t", args[1], "copy-pipe-and-cancel", f"sh '{CLIP_SH}'")
        if args[2:3] == ["vi"]:  # the old binding switched mode-keys for this copy
            tmux("set-option", "-wu", "-t", args[1], "mode-keys")
    elif cmd in ("install", "uninstall"):
        run_install(remove=cmd == "uninstall")
    elif cmd in ("-v", "--version"):
        print(f"gmux {VERSION}")
    elif cmd.startswith("-"):
        print(__doc__.strip())
    else:
        run_open(cmd)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:  # Ctrl+C: quiet exit (curses already restored the terminal)
        sys.exit(130)
