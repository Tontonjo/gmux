# Menu gmux dans un panneau latéral temporaire. Les menus natifs de tmux ne
# conviennent pas: en 3.1 tout mouvement de souris y compte comme un relâchement
# (fermeture ou choix involontaire), et avant 3.5 ils n'ont pas de souris au clavier.

MENU_WIDTH = 40
MOUSE_ALL = "\033[?1003h"  # le terminal signale aussi les mouvements (survol)


def picker_rows():
    """Lignes du menu: ("item", libellé, touche, cmd) / ("title", texte)."""
    sections = menu_items()
    rows = [("item", *it) for it in sections[""]]
    for name in SECTIONS:
        rows += [("title", name)] + [("item", *it) for it in sections[name]]
    return rows


class Picker:
    def __init__(self, scr, rows):
        self.scr, self.rows = scr, rows
        self.items = [i for i, r in enumerate(rows) if r[0] == "item"]
        self.sel = self.top = 0
        curses.curs_set(0)
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)  # élément survolé
        curses.init_pair(2, curses.COLOR_YELLOW, -1)                # titres de section
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        curses.mouseinterval(0)  # appui et relâchement séparés, sans délai
        print(MOUSE_ALL, end="", flush=True)
        scr.keypad(True)

    def draw(self):
        s = self.scr
        s.erase()
        h, w = s.getmaxyx()
        view = max(1, h - 2)
        cur = self.items[self.sel]
        if cur < self.top:
            self.top = cur - (1 if cur and self.rows[cur - 1][0] == "title" else 0)
        elif cur >= self.top + view:
            self.top = cur - view + 1
        s.addnstr(0, 0, f" gmux v{VERSION} ".center(w), w - 1, curses.A_REVERSE | curses.A_BOLD)
        for y, r in enumerate(self.rows[self.top:self.top + view], start=1):
            if r[0] == "title":  # titre: ligne de séparation, non cliquable
                s.addnstr(y, 0, f"── {r[1].upper()} ".ljust(w, "─"), w - 1,
                          curses.color_pair(2) | curses.A_DIM)
            else:
                text = f"   {r[1]}".ljust(w - 6) + f"({r[2]})".rjust(5)
                attr = curses.color_pair(1) if self.top + y - 1 == cur else 0
                s.addnstr(y, 0, text.ljust(w - 1), w - 1, attr)
        s.addnstr(h - 1, 1, "clic/Entrée: OK  Échap: fermer", w - 2, curses.A_DIM)
        s.refresh()

    def item_at(self, y):
        idx = self.top + y - 1
        return self.items.index(idx) if 0 < y < self.scr.getmaxyx()[0] - 1 and idx in self.items else None

    def loop(self):
        """Retourne la commande tmux choisie, ou None."""
        keys = {self.rows[i][2]: i for i in self.items}
        while True:
            self.draw()
            ch = self.scr.get_wch()
            if ch == curses.KEY_MOUSE:
                try:
                    _, _, y, _, b = curses.getmouse()
                except curses.error:
                    continue
                if b & WHEEL_UP:
                    ch = curses.KEY_UP
                elif b & WHEEL_DOWN:
                    ch = curses.KEY_DOWN
                else:
                    pos = self.item_at(y)
                    if pos is not None:
                        self.sel = pos  # survol ou clic: surbrillance
                        if b & (curses.BUTTON1_RELEASED | curses.BUTTON1_CLICKED):
                            return self.rows[self.items[pos]][3]
                    continue
            if ch in ("\x1b", "q"):
                return None
            if ch in (curses.KEY_UP, curses.KEY_DOWN):
                self.sel = (self.sel + (1 if ch == curses.KEY_DOWN else -1)) % len(self.items)
            elif ch in ("\n", "\r", curses.KEY_ENTER):
                return self.rows[self.items[self.sel]][3]
            elif ch in keys:
                return self.rows[keys[ch]][3]


def expanded_rows(orig):
    """Lignes du menu avec libellés et commandes évalués (#W, #S, états on/off)
    pour le panneau `orig`, avant que le menu ne change le nom de la fenêtre."""
    rows = picker_rows()
    texts = [t.replace("%", "%%") for r in rows if r[0] == "item" for t in (r[1], r[3])]
    ok, out = tmux("display-message", "-p", "-t", orig, " @@ ".join(texts))  # %% -> %
    if not ok:
        return rows
    values = iter(out.rstrip("\n").split(" @@ "))
    return [("item", next(values), r[2], next(values)) if r[0] == "item" else r for r in rows]


def run_pick(orig, rows_path):
    """Tourne dans le panneau du menu. Après le choix, le panneau se ferme et la
    commande s'exécute sur le panneau d'origine `orig`."""
    os.environ.setdefault("ESCDELAY", "25")
    with open(rows_path) as f:
        rows = [tuple(r) for r in json.load(f)]
    os.remove(rows_path)
    try:
        cmd = curses.wrapper(lambda scr: Picker(scr, rows).loop())
    finally:
        print("\033[?1003l", end="", flush=True)
    if not cmd:
        return
    # Lancé en arrière-plan une fois ce panneau fermé, sinon la commande pourrait
    # viser le panneau du menu (échange, fermeture, zoom...).
    script = f"select-window -t {orig}\nselect-pane -t {orig}\n{cmd}\n"
    env = {k: v for k, v in os.environ.items() if k != "TMUX_PANE"}
    subprocess.Popen(["sh", "-c", 'sleep 0.2; printf "%s" "$1" | tmux source-file -', "sh", script],
                     env=env, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_menu(orig=None):
    """Ouvre le menu à gauche du panneau `orig` (ou dans une fenêtre si trop étroit).
    Si un menu est déjà ouvert, le referme à la place (bascule)."""
    orig = orig or os.environ.get("TMUX_PANE", "")
    ok, panes = tmux("list-panes", "-a", "-F", "#{pane_id} #{pane_start_command}")
    marker = f'"{SELF}" pick '  # commande du panneau menu (tmux >= 3.2 échappe les ")
    open_menus = [p.split()[0] for p in panes.splitlines()
                  if marker in p.replace('\\"', '"')] if ok else []
    if open_menus:  # un menu est déjà ouvert: un nouveau clic le referme
        for pane in open_menus:
            tmux("kill-pane", "-t", pane)
        return
    fd, rows_path = tempfile.mkstemp(prefix="gmux-", suffix=".json")
    with os.fdopen(fd, "w") as f:
        json.dump(expanded_rows(orig), f)
    pick = f'"{SELF}" pick "{orig}" "{rows_path}"'
    ok, width = tmux("display-message", "-p", "-t", orig, "#{window_width}")
    if ok and width.strip().isdigit() and int(width) >= MENU_WIDTH + 20:
        ok, err = tmux("split-window", "-h", "-b", "-f", "-l", str(MENU_WIDTH), "-t", orig, pick)
    else:
        ok, err = tmux("new-window", "-n", "gmux", "-t", orig, pick)
    if not ok:
        os.remove(rows_path)
        tmux("display-message", f"gmux: {err}")
        print(f"gmux: {err}", file=sys.stderr)


# ---------------------------------------------------------------- status perf

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache"),
                     "gmux-status.json")
SKIP_NET = ("lo", "veth", "docker", "br-")
SKIP_DISK = ("loop", "ram", "zram", "dm-", "md", "sr")


def counters_psutil():
    import psutil
    c = psutil.cpu_times()
    idle = c.idle + getattr(c, "iowait", 0)
    total = sum(c) - getattr(c, "guest", 0) - getattr(c, "guest_nice", 0)
    m = psutil.virtual_memory()
    io = psutil.disk_io_counters()
    n = psutil.net_io_counters()
    return {"cpu": [total - idle, total], "mem": [m.total - m.available, m.total],
            "io": [io.read_bytes, io.write_bytes] if io else [0, 0],
            "net": [n.bytes_recv, n.bytes_sent]}


def counters_proc():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:9]]
    idle, total = v[3] + v[4], sum(v)
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, val = line.split(":")
            mem[k] = int(val.split()[0]) * 1024
    disks = {d for d in os.listdir("/sys/block") if not d.startswith(SKIP_DISK)}
    rd = wr = 0
    with open("/proc/diskstats") as f:
        for line in f:
            p = line.split()
            if p[2] in disks:
                rd, wr = rd + int(p[5]) * 512, wr + int(p[9]) * 512
    rx = tx = 0
    with open("/proc/net/dev") as f:
        for line in f.readlines()[2:]:
            iface, data = line.split(":", 1)
            if not iface.strip().startswith(SKIP_NET):
                d = data.split()
                rx, tx = rx + int(d[0]), tx + int(d[8])
    return {"cpu": [total - idle, total],
            "mem": [mem["MemTotal"] - mem.get("MemAvailable", mem["MemFree"]), mem["MemTotal"]],
            "io": [rd, wr], "net": [rx, tx]}


def read_counters():
    try:
        return counters_psutil()
    except ImportError:
        return counters_proc() if os.path.exists("/proc/stat") else None


def human(n):
    for unit in "BKMGT":
        if n < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}P"


def colored(pct, text):
    color = "green" if pct < 60 else "yellow" if pct < 85 else "red"
    return f"#[fg={color}]{text}#[default]"


def run_status():
    disk = shutil.disk_usage("/")
    disk_pct = 100 * disk.used / disk.total
    disk_txt = colored(disk_pct, f"/ {disk_pct:.0f}%")
    cur = read_counters()
    if cur is None:
        print(f"{disk_txt} (pip install psutil pour plus)")
        return

    now = time.time()
    try:
        with open(STATE) as f:
            prev = json.load(f)
    except (OSError, ValueError):
        prev = None
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            json.dump({"t": now, **cur}, f)
    except OSError:
        pass

    dt = now - prev["t"] if prev else 0
    if dt <= 0:
        cpu, io, net = 0.0, [0, 0], [0, 0]
    else:
        busy, total = (c - p for c, p in zip(cur["cpu"], prev["cpu"]))
        cpu = 100 * busy / total if total > 0 else 0.0
        io = [max(0, c - p) / dt for c, p in zip(cur["io"], prev["io"])]
        net = [max(0, c - p) / dt for c, p in zip(cur["net"], prev["net"])]

    used, total = cur["mem"]
    mem_pct = 100 * used / total
    print(" ".join([
        colored(cpu, f"CPU {cpu:.0f}%"),
        colored(mem_pct, f"RAM {human(used)}/{human(total)}"),
        f"IO r{human(io[0])} w{human(io[1])}",
        f"NET ↓{human(net[0])} ↑{human(net[1])}",
        disk_txt,
    ]))


# ---------------------------------------------------------------- install

BEGIN, END = "# >>> gmux >>>", "# <<< gmux <<<"


MENU_BIND = f"run-shell -b '\"{SELF}\" menu \"#{{pane_id}}\"'"


def gmux_conf():
    """Config tmux générée: barre de statut et accès au menu (clavier + souris)."""
    return "\n".join([
        f"# Généré par gmux v{VERSION}. Ne pas modifier: relancer 'gmux install'.",
        "set -g mouse on",
        "set -g status-interval 2",
        "set -g status-left-length 120",
        f"set -g status-left '#[bold][#S]#[nobold] #(\"{SELF}\" status) '",
        f"bind m {MENU_BIND}",
        # clic gauche sur le nom de session, clic droit n'importe où sur la barre
        *(f"bind -n {ev} {MENU_BIND}"
          for ev in ("MouseUp1StatusLeft", "MouseUp3StatusLeft", "MouseUp3Status",
                     "MouseUp3StatusRight")),
        # retire les menus natifs ouverts à l'appui, y compris ceux d'anciennes versions
        *(f"unbind -n {ev}" for ev in ("MouseDown1StatusLeft", "MouseDown3StatusLeft",
                                        "MouseDown3Status", "MouseDown3StatusRight")),
        ""])


def conf_block():
    return "\n".join([BEGIN, f"source-file \"{GMUX_CONF}\"", END, ""])


def strip_block(text):
    if BEGIN in text and END in text:
        start, end = text.index(BEGIN), text.index(END) + len(END)
        text = text[:start].rstrip("\n") + text[end:].lstrip("\n")
        text = text + "\n" if text and not text.endswith("\n") else text
    return text


def run_install(remove=False):
    text = strip_block(open(CONF).read() if os.path.exists(CONF) else "")
    if remove:
        if os.path.exists(GMUX_CONF):
            os.remove(GMUX_CONF)
    else:
        os.makedirs(os.path.dirname(GMUX_CONF), exist_ok=True)
        with open(GMUX_CONF, "w") as f:
            f.write(gmux_conf())
        text = (text + "\n" if text else "") + conf_block()
    with open(CONF, "w") as f:
        f.write(text)
    if remove:
        print(f"Config gmux retirée. Redémarre tmux pour annuler les réglages actifs.")
        return
    reloaded, _ = tmux("source-file", CONF)
    print(f"Config gmux installée ({GMUX_CONF})" + (" et rechargée." if reloaded else "."))
    print("Menu: clic sur le nom de session, clic droit sur la barre, ou prefix + m.")


def run_open(name):
    """S'attache à la session NAME, la crée d'abord si elle n'existe pas."""
    if not tmux("has-session", "-t", f"={name}")[0]:
        ok, err = tmux("new-session", "-d", "-s", name)
        if not ok:
            sys.exit(f"gmux: {err}")
    if INSIDE:
        tmux("switch-client", "-t", f"={name}")
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={name}"])


# ---------------------------------------------------------------- main

def main():
    if not shutil.which("tmux"):
        sys.exit("gmux: tmux n'est pas installé.")
    args = sys.argv[1:]
    cmd = args[0] if args else ("menu" if INSIDE else "tui")
    if cmd == "tui":
        run_tui()
    elif cmd == "menu":
        run_menu(*args[1:2])
    elif cmd == "pick" and len(args) > 2:
        run_pick(args[1], args[2])
    elif cmd == "status":
        run_status()
    elif cmd in ("install", "uninstall"):
        run_install(remove=cmd == "uninstall")
    elif cmd in ("-v", "--version"):
        print(f"gmux {VERSION}")
    elif cmd.startswith("-"):
        print(__doc__.strip())
    else:
        run_open(cmd)


if __name__ == "__main__":
    main()
