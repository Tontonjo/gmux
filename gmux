#!/usr/bin/env python3
# gmux: simple tmux manager (mouse + keyboard)
# Version: 1.15.0
"""
Usage:
  gmux              outside tmux: session manager / inside tmux: menu
  gmux NAME         attach to session NAME, create it if it does not exist
  gmux tui          session manager (list, create, attach, rename, kill)
  gmux menu         menu: windows, panes, session, settings
  gmux install      generate the gmux config, link it from ~/.tmux.conf and reload
                    (automatic on first run and after an update)
  gmux uninstall    remove the gmux config
  gmux -v           show the version
"""
VERSION = "1.15.0"

import curses
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

SELF = os.path.abspath(__file__)
INSIDE = bool(os.environ.get("TMUX"))
CONF = os.path.expanduser("~/.tmux.conf")
GMUX_CONF = os.path.expanduser("~/.config/gmux/gmux.tmux.conf")
CLIP_SH = os.path.expanduser("~/.config/gmux/clip.sh")


# ---------------------------------------------------------------- tmux helpers

def tmux(*args):
    """Run a tmux command. Return (ok, output or error message)."""
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return r.returncode == 0, (r.stdout if r.returncode == 0 else r.stderr.strip())


def notify(msg, ms=4000):
    """Show a message in the tmux status bar for `ms` milliseconds."""
    if tmux("display-message", "-d", str(ms), msg)[0]:
        return
    # tmux < 3.2 has no -d: raise display-time just for this message
    ok, old = tmux("show-options", "-gv", "display-time")
    tmux("set-option", "-g", "display-time", str(ms))
    tmux("display-message", msg)
    tmux("set-option", "-g", "display-time", old.strip() if ok and old.strip() else "750")


def list_sessions():
    fmt = "#{session_name}\t#{session_windows}\t#{session_attached}\t#{session_created}"
    ok, out = tmux("list-sessions", "-F", fmt)
    if not ok:
        return []  # no server = no session
    sessions = []
    for line in out.splitlines():
        name, win, att, created = line.split("\t")
        sessions.append({"name": name, "windows": int(win),
                         "attached": int(att), "created": int(created)})
    return sessions


def current_session():
    if not INSIDE:
        return None
    ok, out = tmux("display-message", "-p", "#S")
    return out.strip() if ok else None


# ---------------------------------------------------------------- TUI sessions

WHEEL_UP = curses.BUTTON4_PRESSED
WHEEL_DOWN = getattr(curses, "BUTTON5_PRESSED", 0x200000)
LIST_TOP = 3
BUTTONS = [("Enter", "Attach", "attach"), ("n", "New", "new"),
           ("r", "Rename", "rename"), ("x", "Kill", "kill"), ("q", "Quit", "quit")]
KEYS = {"\n": "attach", "\r": "attach", curses.KEY_ENTER: "attach",
        "n": "new", "r": "rename", "x": "kill", "d": "kill", curses.KEY_DC: "kill",
        "q": "quit", "\x1b": "quit",
        curses.KEY_UP: "up", "k": "up", curses.KEY_DOWN: "down", "j": "down",
        curses.KEY_HOME: "home", curses.KEY_END: "end"}


class SessionTUI:
    def __init__(self, scr):
        self.scr = scr
        self.sel = self.top = 0
        self.msg = ""
        self.buttons = []  # [(x0, x1, action)] for clicks
        self.current = current_session()
        curses.curs_set(0)
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)   # selection
        curses.init_pair(2, curses.COLOR_GREEN, -1)                  # attached
        curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_WHITE)  # buttons
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        scr.keypad(True)
        scr.timeout(2000)  # refresh the list every 2 s
        self.reload()

    # -- data
    def reload(self, select=None):
        self.sessions = list_sessions()
        if select is not None:
            names = [s["name"] for s in self.sessions]
            self.sel = names.index(select) if select in names else self.sel
        self.sel = max(0, min(self.sel, len(self.sessions) - 1))

    def selected(self):
        return self.sessions[self.sel]["name"] if self.sessions else None

    # -- display
    def draw(self):
        s = self.scr
        s.erase()
        h, w = s.getmaxyx()
        title = f" gmux v{VERSION}  tmux sessions ".ljust(w)
        s.addnstr(0, 0, title, w, curses.A_REVERSE | curses.A_BOLD)
        s.addnstr(2, 2, f"{'SESSION':<24} {'WIN':>4}  {'STATE':<10} CREATED", w - 3, curses.A_DIM)

        rows = max(1, h - LIST_TOP - 2)
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + rows:
            self.top = self.sel - rows + 1

        if not self.sessions:
            s.addnstr(LIST_TOP, 2, "No session. Press n (or click New).", w - 3)
        for i, ses in enumerate(self.sessions[self.top:self.top + rows]):
            idx = self.top + i
            state = "● attached" if ses["attached"] else ""
            mark = "*" if ses["name"] == self.current else " "
            created = time.strftime("%b %d %H:%M", time.localtime(ses["created"]))
            line = f"{mark} {ses['name'][:24]:<24} {ses['windows']:>4}  {state:<10} {created}"
            attr = curses.color_pair(1) if idx == self.sel else (
                curses.color_pair(2) if ses["attached"] else 0)
            s.addnstr(LIST_TOP + i, 0, line.ljust(w - 1), w - 1, attr)

        if self.msg:
            s.addnstr(h - 2, 1, self.msg, w - 2, curses.A_BOLD)
        self.draw_buttons(h - 1, [(f"{k} {label}", act) for k, label, act in BUTTONS])
        s.refresh()

    def draw_buttons(self, y, items):
        """Draw clickable buttons on line y and remember their area."""
        w = self.scr.getmaxyx()[1]
        self.scr.move(y, 0)
        self.scr.clrtoeol()
        self.buttons, x = [], 1
        for text, act in items:
            text = f" {text} "
            if x + len(text) >= w:
                break
            self.scr.addstr(y, x, text, curses.color_pair(3))
            self.buttons.append((x, x + len(text), act))
            x += len(text) + 1

    # -- input
    def mouse(self):
        """Translate a mouse event into an action (or None)."""
        try:
            _, x, y, _, b = curses.getmouse()
        except curses.error:
            return None
        if b & WHEEL_UP:
            return "up"
        if b & WHEEL_DOWN:
            return "down"
        for x0, x1, act in self.buttons:
            if y == self.scr.getmaxyx()[0] - 1 and x0 <= x < x1:
                return act
        idx = y - LIST_TOP + self.top
        if y >= LIST_TOP and 0 <= idx < len(self.sessions):
            self.sel = idx
            if b & curses.BUTTON1_DOUBLE_CLICKED:
                return "attach"
        return None

    def read_action(self):
        try:
            ch = self.scr.get_wch()
        except curses.error:
            return None  # timeout: plain refresh
        if ch == curses.KEY_MOUSE:
            return self.mouse()
        return KEYS.get(ch)

    def prompt(self, label, init=""):
        """Read one line. Enter confirms, Esc cancels (returns None)."""
        buf = list(init)
        h, w = self.scr.getmaxyx()
        self.scr.timeout(-1)
        curses.curs_set(1)
        try:
            while True:
                text = label + "".join(buf)
                self.scr.move(h - 2, 0)
                self.scr.clrtoeol()
                self.scr.addnstr(h - 2, 1, text, w - 2, curses.A_BOLD)
                self.draw_buttons(h - 1, [("Enter OK", "ok"), ("Esc Cancel", "cancel")])
                self.scr.move(h - 2, min(1 + len(text), w - 2))
                ch = self.scr.get_wch()
                act = self.mouse() if ch == curses.KEY_MOUSE else None
                if ch in ("\n", "\r", curses.KEY_ENTER) or act == "ok":
                    return "".join(buf).strip()
                if ch == "\x1b" or act == "cancel":
                    return None
                if ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    buf = buf[:-1]
                elif isinstance(ch, str) and ch.isprintable():
                    buf.append(ch)
        finally:
            curses.curs_set(0)
            self.scr.timeout(2000)

    def confirm(self, question):
        h = self.scr.getmaxyx()[0]
        self.scr.timeout(-1)
        try:
            while True:
                self.scr.move(h - 2, 0)
                self.scr.clrtoeol()
                self.scr.addnstr(h - 2, 1, question, self.scr.getmaxyx()[1] - 2, curses.A_BOLD)
                self.draw_buttons(h - 1, [("y Yes", "yes"), ("n No", "no")])
                ch = self.scr.get_wch()
                act = self.mouse() if ch == curses.KEY_MOUSE else None
                if ch in ("y", "Y") or act == "yes":
                    return True
                if ch in ("n", "N", "\x1b") or act == "no":
                    return False
        finally:
            self.scr.timeout(2000)

    # -- actions
    def act_new(self):
        name = self.prompt("New session name (empty = auto): ")
        if name is None:
            return
        args = ["new-session", "-d", "-P", "-F", "#S"] + (["-s", name] if name else [])
        ok, out = tmux(*args)
        self.msg = f"Session '{out.strip()}' created. Press Enter to attach." if ok else out
        self.reload(select=out.strip() if ok else None)

    def act_rename(self):
        old = self.selected()
        if not old:
            return
        new = self.prompt("New name: ", old)
        if not new or new == old:
            return
        ok, out = tmux("rename-session", "-t", f"={old}", new)
        self.msg = f"'{old}' renamed to '{new}'." if ok else out
        if ok and old == self.current:
            self.current = new
        self.reload(select=new if ok else None)

    def act_kill(self):
        name = self.selected()
        if name and self.confirm(f"Kill session '{name}'?"):
            ok, out = tmux("kill-session", "-t", f"={name}")
            self.msg = f"Session '{name}' killed." if ok else out
            self.reload()

    def loop(self):
        """Main loop. Return the session name to attach to, or None."""
        while True:
            self.draw()
            act = self.read_action()
            if act is None:
                self.reload()
                continue
            self.msg = ""
            if act == "quit":
                return None
            if act == "attach" and self.selected():
                return self.selected()
            if act in ("up", "down"):
                self.sel = max(0, min(len(self.sessions) - 1, self.sel + (1 if act == "down" else -1)))
            elif act == "home":
                self.sel = 0
            elif act == "end":
                self.sel = max(0, len(self.sessions) - 1)
            elif act == "new":
                self.act_new()
            elif act == "rename":
                self.act_rename()
            elif act == "kill":
                self.act_kill()


def run_tui():
    os.environ.setdefault("ESCDELAY", "25")  # responsive Esc key
    target = curses.wrapper(lambda scr: SessionTUI(scr).loop())
    if not target:
        return
    if INSIDE:
        tmux("switch-client", "-t", f"={target}")
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={target}"])


